---
import markLarge from '../assets/icons/mark-large.svg?raw';
import { site } from '../data/site';
---

<section id="start" class="section cta" data-track-section="cta">
  <div class="container cta__inner">
    <span class="cta__mark" set:html={markLarge} />
    <h2 class="cta__title">Launch a fleet in four commands.</h2>
    <!--
      Commands wrap with shell line continuations: no line is longer than 40 characters, so the
      block fits at 1280 px and at 390 px without a sideways scroll (the scroller stays as a
      fallback for narrower screens, focusable so it works from the keyboard). Inside the quoted
      prompt the continuation lines start at column 0: an indent would add spaces to the prompt.
      The `$` prompts and the comment are not selectable, so a copied selection is the four
      commands alone (zsh without interactivecomments would reject a pasted `#` line).
    -->
    <pre class="code cta__code"><code class="code__scroll" tabindex="0" role="region" aria-label="Quick start commands"><span class="dim cta__nocopy">$ </span>npx duskfleet init
<span class="dim cta__nocopy">$ </span>npx duskfleet agents create fixer \
    --model haiku --budget 0.25 -- \
    "You fix the failing test in this \
project. Use the Read, Glob and Grep \
tools to look at files; use Bash only \
to run npm test. Run the tests, read \
the failure, change the minimum code, \
run them again. No git, no installs."
<span class="dim cta__nocopy">$ </span>npx duskfleet run \
    --project /path/to/project \
    --agent fixer -- \
    "Fix the failing test"
<span class="dim cta__nocopy"># open the dashboard to watch the run</span>
<span class="dim cta__nocopy">$ </span>npx duskfleet dashboard</code></pre>
    <p class="cta__source">
      Contributors can also
      <a href={`${site.repo}#from-source`} target="_blank" rel="noopener">build from source</a>
      with <code>git clone</code>.
    </p>
    <div class="cta__actions">
      <a
        href={site.repo}
        class="btn btn--primary"
        target="_blank"
        rel="noopener"
        data-track="click_github"
        data-track-location="cta"
        data-track-target="repo">Star on GitHub</a
      >
      <a
        href={site.links.docs}
        class="btn btn--ghost"
        target="_blank"
        rel="noopener"
        data-track="click_docs"
        data-track-location="cta"
        data-track-doc="readme">Read the docs</a
      >
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(180deg, #0e1020 0%, #1a1430 100%);
    padding-block: 96px;
  }

  .cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cta__mark :global(svg) {
    width: 96px;
    height: 96px;
  }

  .cta__title {
    margin-top: 24px;
    font-size: 44px;
    font-weight: 700;
    line-height: 46px;
    letter-spacing: -0.025em;
  }

  .cta__code {
    width: 100%;
    max-width: 640px;
    margin-top: 24px;
    padding: 20px;
    font-size: 14px;
    line-height: 22.5px;
    text-align: left;
    border-radius: 12px;
  }

  .cta__nocopy {
    -webkit-user-select: none;
    user-select: none;
  }

  .cta__source {
    margin-top: var(--space-3);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .cta__source a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cta__source code {
    font-family: var(--font-mono);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 640px) {
    .cta {
      padding-block: 64px;
    }

    .cta__title {
      font-size: 32px;
      line-height: 36px;
    }

    /* 40 characters at 12.5px Geist Mono (0.6em advance) take 300px: they fit the 316px
       inside a 390px viewport (20px gutters, 16px padding, 1px border). */
    .cta__code {
      padding: var(--space-4);
      font-size: 12.5px;
      line-height: 19.5px;
    }
  }
</style>
