---
import Lockup from './Lockup.astro';
import { footerColumns, trackAttrs } from '../data/site';

const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (href: string) => (href.startsWith('#') ? `${base}/${href}` : href.startsWith('/') ? base + href : href);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Lockup />
      <p class="footer__signature">Your agents sail at dusk.</p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {
        footerColumns.map((col) => (
          <div class="footer__col">
            <span class="footer__heading">{col.title}</span>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a
                    href={url(l.href)}
                    target={l.external ? '_blank' : undefined}
                    rel={l.external ? 'noopener' : undefined}
                    {...trackAttrs(l.track)}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <p class="footer__copy">© {year} Duskfleet. Open source, MIT license.</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 40px;
    background: var(--bg);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* typography/tagline/secondary */
  .footer__signature {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  /* typography/small */
  .footer__copy {
    flex-basis: 100%;
    text-align: right;
    font-size: 13px;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .footer__copy {
      text-align: left;
    }
  }

  .footer__cols {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer__heading {
    display: block;
    font-size: 14px;
    font-weight: 600;
    line-height: 21px;
  }

  .footer__col ul {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__col a {
    font-size: 14px;
    line-height: 21px;
    color: var(--muted);
    transition: color 120ms ease;
  }

  .footer__col a:hover {
    color: var(--text);
  }
</style>
