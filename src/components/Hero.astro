---
/**
 * Hero (Figma Hero/Desktop 196:8, Hero/Mobile 196:37).
 * The H1 is the primary tagline; the demo card always carries its "example data" pill.
 */
import { site } from '../data/site';
---

<section id="top" class="hero" data-track-section="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="hero__title">A fleet of agents for your own machine.</h1>
      <p class="hero__lead">
        Duskfleet runs Claude Code agents (claude -p) in your local projects, on demand or on a cron
        schedule, records every run in SQLite and shows it in a dashboard on localhost.
      </p>
      <div class="hero__actions">
        <a href="#start" class="btn btn--primary" data-track="click_install_cta" data-track-location="hero">Install the local version</a>
        <a
          href={site.repo}
          class="btn btn--ghost"
          target="_blank"
          rel="noopener"
          data-track="click_github"
          data-track-location="hero"
          data-track-target="repo">Star on GitHub</a
        >
      </div>
      <p class="hero__req">macOS · Linux · Node 24+ · Claude Code logged in</p>
    </div>

    <div class="demo panel" role="group" aria-label="Dashboard preview, example data">
      <div class="demo__head">
        <p class="demo__title">Dashboard · today</p>
        <p class="demo__pill">example data</p>
      </div>
      <dl class="demo__stats">
        <div class="demo__stat">
          <dt class="demo__label">Running</dt>
          <dd class="demo__value demo__value--running">2</dd>
        </div>
        <div class="demo__stat">
          <dt class="demo__label">Needs review</dt>
          <dd class="demo__value demo__value--review">1</dd>
        </div>
        <div class="demo__stat">
          <dt class="demo__label">Spent today</dt>
          <dd class="demo__value">$1.84</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 68px 96px;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    align-items: center;
    gap: 64px;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
  }

  /* typography/hero */
  .hero__title {
    max-width: 600px;
    font-size: 64px;
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    max-width: 560px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  /* typography/code */
  .hero__req {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Demo card (example data) */
  .demo {
    overflow: hidden;
  }

  .demo__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 14px var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .demo__title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
  }

  /* typography/label */
  .demo__pill,
  .demo__label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .demo__pill {
    padding: 3px 10px;
    border: 1px solid var(--muted);
    border-radius: 999px;
  }

  .demo__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin: 0;
    padding: 18px var(--space-5) var(--space-5);
  }

  .demo__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* typography/stat */
  .demo__value {
    margin: 0;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .demo__value--running {
    color: var(--run);
  }

  .demo__value--review {
    color: var(--sunset-amber);
  }

  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .demo {
      max-width: 480px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 20px 48px;
    }

    .hero__copy {
      gap: var(--space-4);
    }

    /* typography/tagline/primary */
    .hero__title {
      font-size: 32px;
      font-weight: 600;
      line-height: 1.18;
      letter-spacing: 0;
    }

    .hero__lead {
      font-size: 16px;
    }

    .demo__stats {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }
  }
</style>
