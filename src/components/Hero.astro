---
import StatusPill from './StatusPill.astro';
import { heroRuns, site } from '../data/site';
---

<section id="top" class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__badge"><span class="hero__dot" aria-hidden="true"></span>Runs Claude Code · no account, no cloud</p>
      <h1 class="hero__title">A fleet of agents<br />for your own machine.</h1>
      <p class="hero__lead">
        DuskFleet runs autonomous Claude Code agents on your local projects, unattended and on a
        schedule, and records every run: each tool call, each denial, each dollar.
      </p>
      <div class="hero__actions">
        <a href="#start" class="btn btn--primary">Install the local version</a>
        <a href={site.repo} class="btn btn--ghost" target="_blank" rel="noopener">Star on GitHub</a>
      </div>
      <p class="hero__req">macOS · Linux · Node 24+ · Claude Code logged in</p>
    </div>

    <figure class="mock panel" aria-label="Preview of the DuskFleet dashboard">
      <div class="mock__tabs">
        <span class="mock__tab mock__tab--active">Runs</span>
        <span class="mock__tab">Agents</span>
        <span class="mock__tab">Schedules</span>
        <span class="mock__tab">MCP</span>
        <span class="mock__live"><span class="hero__dot" aria-hidden="true"></span>live</span>
      </div>
      <div class="mock__stats">
        <div class="mock__stat">
          <span class="mock__label">Running</span>
          <span class="mock__value mock__value--run">2</span>
        </div>
        <div class="mock__stat">
          <span class="mock__label">Needs review</span>
          <span class="mock__value mock__value--amber">1</span>
        </div>
        <div class="mock__stat">
          <span class="mock__label">Spent today</span>
          <span class="mock__value">$1.84</span>
        </div>
      </div>
      <ul class="mock__runs">
        {
          heroRuns.map((run) => (
            <li class="mock__run">
              <StatusPill status={run.status} />
              <span class="mock__run-title">{run.title}</span>
              <span class="mock__run-meta">{run.meta}</span>
            </li>
          ))
        }
      </ul>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: 72px 80px;
  }

  .hero__glow {
    position: absolute;
    left: 50%;
    top: -220px;
    width: 900px;
    height: 900px;
    margin-left: -450px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(240, 120, 58, 0.16) 0%,
      rgba(226, 75, 90, 0.08) 35%,
      transparent 65%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 555px) minmax(0, 517px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px;
    border-radius: 15px;
    background: var(--panel);
    border: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 20%, transparent);
  }

  .hero__title {
    margin-top: 24px;
    font-size: 64px;
    font-weight: 700;
    line-height: 65.5px;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    margin-top: 24px;
    font-size: 20px;
    line-height: 30px;
    color: var(--muted);
    max-width: 556px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .hero__req {
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 19.5px;
    color: var(--faint);
  }

  /* Dashboard mock */
  .mock {
    overflow: hidden;
    box-shadow: var(--shadow-hero);
    font-size: 13px;
  }

  .mock__tabs {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
  }

  .mock__tab--active {
    color: var(--text);
    font-weight: 600;
  }

  .mock__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
  }

  .mock__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
  }

  .mock__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    background: var(--panel);
  }

  .mock__label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .mock__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 26px;
    line-height: 39px;
  }

  .mock__value--run {
    color: var(--run);
  }

  .mock__value--amber {
    color: var(--sunset-amber);
  }

  .mock__runs {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .mock__run {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
  }

  .mock__run + .mock__run {
    border-top: 1px solid var(--border);
  }

  .mock__run-title {
    font-size: 14px;
    line-height: 21px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .mock__run-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
    }

    .mock {
      max-width: 560px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: 48px 56px;
    }

    .hero__title {
      font-size: 42px;
      line-height: 44px;
    }

    .hero__lead {
      font-size: 17px;
      line-height: 26px;
    }

    .mock__run {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .mock__run-meta {
      grid-column: 2;
    }

    .mock__stat {
      padding-inline: 12px;
    }

    .mock__label {
      font-size: 10px;
      letter-spacing: 0.05em;
    }

    .mock__value {
      font-size: 22px;
      line-height: 32px;
    }
  }
</style>
