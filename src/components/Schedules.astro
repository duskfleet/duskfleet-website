---
import { week, weekLegend } from '../data/site';
---

<section class="section section--alt">
  <div class="container split">
    <figure class="panel week" aria-label="A week of nightly ticks">
      <div class="week__head">
        <span class="week__name">app · nightly tests</span>
        <span class="week__cron">0 2 * * * · Europe/Rome</span>
      </div>
      <ul class="week__days">
        {
          week.map((d) => (
            <li class="week__day">
              <span class={`tick tick--${d.tick}`} aria-hidden="true" />
              <span class="week__label">{d.day}</span>
            </li>
          ))
        }
      </ul>
      <ul class="week__legend">
        {
          weekLegend.map((l) => (
            <li>
              <span class={`tick tick--${l.tick} tick--sm`} aria-hidden="true" />
              {l.label}
            </li>
          ))
        }
      </ul>
    </figure>

    <div class="split__copy">
      <p class="eyebrow">Schedules</p>
      <h2 class="h2">Ticks keep the fleet moving.</h2>
      <p class="lead">
        One process holds the lease and ticks the clock. A tick that finds the agent busy is written
        down as skipped. A laptop that was asleep does not replay what it missed. One flag in the
        config stops everything.
      </p>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 601px) minmax(0, 471px);
    justify-content: space-between;
    align-items: center;
    gap: 48px;
  }

  .week {
    padding: 20px 24px 22px;
  }

  .week__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .week__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 17px;
    line-height: 25.5px;
  }

  .week__cron {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .week__days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
  }

  .week__day {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .tick {
    display: block;
    width: 100%;
    height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
  }

  .tick--ok {
    background: var(--ok);
    border-color: var(--ok);
  }

  .tick--review {
    background: var(--sunset-amber);
    border-color: var(--sunset-amber);
  }

  .tick--skipped {
    border-color: var(--faint);
  }

  .tick--next {
    background: var(--panel-2);
    border-color: var(--border);
  }

  .tick--sm {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
  }

  .week__label {
    font-size: 12px;
    line-height: 18px;
    color: var(--muted);
  }

  .week__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    list-style: none;
    padding: 0;
    margin: 14px 0 0;
    font-size: 12.5px;
    line-height: 19px;
    color: var(--muted);
  }

  .week__legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  @media (max-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .week {
      order: 2;
      max-width: 601px;
    }

    .split__copy {
      order: 1;
      max-width: 560px;
    }
  }
</style>
