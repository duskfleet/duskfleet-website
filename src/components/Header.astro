---
import Lockup from './Lockup.astro';
import { nav } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const url = (href: string) => (href.startsWith('#') ? home + href : href.startsWith('/') ? base + href : href);
---

<header class="header">
  <div class="container header__inner">
    <a href={home + '#top'} class="logo" aria-label="Duskfleet, back to top">
      <Lockup size="header" />
    </a>
    <nav class="nav" aria-label="Site">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            class="nav__link"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={home + '#start'} class="nav__cta">Install</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
    /* DS-09: the menu's x-height band sits on the wordmark's lowercase line,
       7 px below the lockup box centre (Figma 1101:194). */
    transform: translateY(7px);
  }

  .nav__link {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 15px;
    line-height: 22.5px;
    color: var(--muted);
    transition: color 120ms ease, background-color 120ms ease;
  }

  .nav__link:hover {
    color: var(--text);
    background: var(--panel);
  }

  .nav__cta {
    margin-left: 8px;
    padding: 9px 16px;
    border-radius: 9px;
    background: var(--sunset-amber);
    color: var(--bg);
    font-size: 15px;
    font-weight: 600;
    line-height: 22.5px;
    transition: filter 120ms ease;
  }

  .nav__cta:hover {
    filter: brightness(1.06);
  }

  @media (max-width: 640px) {
    .nav__link {
      display: none;
    }

    /* Mobile has no menu offset (DS-09): only Install shows, centred on the lockup. */
    .nav {
      transform: none;
    }
  }

  /* At 360 px the 320 px row holds the 238.3 px lockup and the 78 px Install only without
     the 8 px lead-in. */
  @media (max-width: 380px) {
    .nav__cta {
      margin-left: 0;
    }
  }
</style>
