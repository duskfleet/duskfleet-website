---
import { stats } from '../data/site';
---

<section class="section section--alt">
  <div class="container split">
    <div class="split__copy">
      <p class="eyebrow">Local, open, small</p>
      <h2 class="h2">No account. No cloud. One database file.</h2>
      <p class="lead">
        Three runtime dependencies, no native addons. The dashboard reads the same SQLite file the
        server writes. Your code never leaves the machine except through Claude Code itself.
      </p>
    </div>

    <ul class="stats">
      {
        stats.map((s) => (
          <li class="stat">
            <span class="stat__value">{s.value}</span>
            <span class="stat__label">{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 540px) minmax(0, 540px);
    justify-content: space-between;
    align-items: start;
    gap: 40px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    padding: 18px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 30px;
    line-height: 45px;
    color: var(--sunset-amber);
  }

  .stat__label {
    font-size: 14px;
    line-height: 21px;
    color: var(--muted);
  }

  @media (max-width: 1024px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .split__copy {
      max-width: 560px;
    }
  }
</style>
