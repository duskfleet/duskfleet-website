---
import '@fontsource-variable/outfit';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(`${base}/og.png`, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0d1a" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={description} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script is:inline define:vars={{ gaId: site.gaId }}>
      /* Consent state + GA4 loader. GA loads only after an explicit Accept
         and only when a measurement id is configured. */
      (function () {
        var KEY = 'duskfleet-consent';
        var loaded = false;
        function read() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'accepted' || v === 'rejected' ? v : null;
          } catch (e) {
            return null;
          }
        }
        function loadAnalytics() {
          if (loaded || !gaId) return;
          loaded = true;
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          /* window.gtag exists only from here on, i.e. only after Accept:
             the event listener below checks it before sending anything. */
          window.gtag = gtag;
          gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'granted',
          });
          gtag('js', new Date());
          gtag('config', gaId);
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        window.duskfleetConsent = {
          get: read,
          set: function (value) {
            try { localStorage.setItem(KEY, value); } catch (e) {}
            if (value === 'accepted') loadAnalytics();
            document.dispatchEvent(new CustomEvent('duskfleet:consent', { detail: value }));
          },
        };
        if (read() === 'accepted') loadAnalytics();
      })();
    </script>
    <script is:inline>
      /* GA4 custom events. Elements carry data-track="<event>" and one
         data-track-<param> per parameter (see Track in src/data/site.ts).
         Nothing is sent unless window.gtag exists (Accept given and GA
         loaded), and an event whose values are not all in ALLOW is dropped:
         no free text, no URLs, no personal data. */
      (function () {
        var ALLOW = {
          click_install_cta: { location: ['hero', 'nav'] },
          click_github: {
            location: ['hero', 'cta', 'header', 'footer'],
            target: ['repo', 'releases', 'license', 'issues'],
          },
          click_docs: {
            location: ['nav', 'cta', 'footer'],
            doc: ['readme', 'agents', 'schedules', 'mcp', 'how-it-works', 'cli', 'configuration', 'dashboard', 'troubleshooting'],
          },
          faq_open: { question: ['api-key', 'run-cost', 'sandbox', 'overlap', 'other-clis', 'data'] },
          view_section: { section: ['hero', 'how-it-works', 'features', 'faq', 'cta'] },
        };
        function send(name, el) {
          if (typeof window.gtag !== 'function') return false;
          var spec = ALLOW[name];
          if (!spec) return false;
          var params = {};
          for (var key in spec) {
            var value = el.getAttribute('data-track-' + key);
            if (spec[key].indexOf(value) === -1) return false;
            params[key] = value;
          }
          window.gtag('event', name, params);
          return true;
        }
        document.addEventListener('click', function (e) {
          var el = e.target instanceof Element ? e.target.closest('a[data-track], button[data-track]') : null;
          if (el) send(el.getAttribute('data-track'), el);
        });
        /* <details> toggle does not bubble: listen in the capture phase. */
        document.addEventListener(
          'toggle',
          function (e) {
            var el = e.target;
            if (el instanceof HTMLDetailsElement && el.open && el.getAttribute('data-track') === 'faq_open') {
              send('faq_open', el);
            }
          },
          true,
        );
        /* view_section: once per section per page view, when the section
           crosses the middle band of the viewport (works for sections of any
           height). Only counted as seen when actually sent, i.e. after Accept. */
        var io = null;
        var pending = [];
        function observe() {
          pending.forEach(function (s) { io.unobserve(s); io.observe(s); });
        }
        function observeSections() {
          if (!('IntersectionObserver' in window)) return;
          io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (entry.isIntersecting && send('view_section', entry.target)) {
                  io.unobserve(entry.target);
                  pending = pending.filter(function (s) { return s !== entry.target; });
                }
              });
            },
            { rootMargin: '-40% 0px -40% 0px' },
          );
          pending = Array.prototype.slice.call(document.querySelectorAll('[data-track-section]'));
          observe();
        }
        /* Accept given on this page: re-observe so the section in view counts. */
        document.addEventListener('duskfleet:consent', function (e) {
          if (io && e.detail === 'accepted') observe();
        });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', observeSections);
        else observeSections();
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
